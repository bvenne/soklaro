{
  "name": "soklaro",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node tools/static-pages.mjs",
    "start": "vite preview",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "TMPDIR=/tmp TEMP=/tmp TMP=/tmp vitest run --exclude \"tests/e2e/**\"",
    "test:watch": "TMPDIR=/tmp TEMP=/tmp TMP=/tmp vitest --exclude \"tests/e2e/**\"",
    "test:e2e": "playwright test",
    "licenses:generate": "node tools/generate-third-party-licenses.mjs && node tools/copy-project-legal.mjs",
    "licenses:check": "node tools/generate-third-party-licenses.mjs --check",
    "release:check": "node tools/check-release.mjs && npm run licenses:check && npm audit --omit=dev",
    "build:native-web": "vite build --config vite.native.config.ts",
    "cap:sync": "npm run build:native-web && cap sync",
    "build:android": "npm run build:native-web && cap sync android",
    "build:ios": "npm run build:native-web && cap sync ios"
  },
  "dependencies": {
    "@capacitor/core": "8.5.1",
    "@capacitor/geolocation": "8.2.2",
    "i18next": "26.4.1",
    "leaflet": "^1.9.4",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/cli": "8.5.1",
    "@capacitor/ios": "8.5.1",
    "@playwright/test": "1.58.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  },
  "overrides": {
    "fflate": "0.7.5",
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
