{
  "name": "soklaro",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "TMPDIR=/tmp TEMP=/tmp TMP=/tmp vitest run --exclude tests/e2e/**",
    "test:watch": "TMPDIR=/tmp TEMP=/tmp TMP=/tmp vitest --exclude tests/e2e/**",
    "test:e2e": "playwright test",
    "licenses:generate": "node tools/generate-third-party-licenses.mjs && node tools/copy-project-legal.mjs",
    "licenses:check": "node tools/generate-third-party-licenses.mjs --check",
    "release:check": "node tools/check-release.mjs && npm run licenses:check && npm audit --omit=dev",
    "build:native-web": "vite build --config vite.native.config.ts",
    "cap:sync": "npm run build:native-web && cap sync",
    "build:android": "npm run build && npm run build:native-web && cap sync android",
    "build:ios": "npm run build && npm run build:native-web && cap sync ios"
  },
  "dependencies": {
    "@capacitor/core": "8.5.1",
    "@capacitor/geolocation": "8.2.2",
    "i18next": "26.4.1",
    "leaflet": "^1.9.4",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.13",
    "react-icons": "5.7.0",
    "react-server-dom-webpack": "19.2.8",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/cli": "8.5.1",
    "@capacitor/ios": "8.5.1",
    "@cloudflare/vite-plugin": "1.54.3",
    "@cloudflare/workers-types": "5.20260902.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.128.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "type": "module"
}
